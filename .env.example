# Ports accessibles uniquement sur la machine locale.
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Clé Google restreinte à YouTube Data API v3, transmise uniquement au backend.
YOUTUBE_API_KEY=
# Plafond interne : tentatives quotidiennes, journée Europe/Paris. 0 désactive la recherche.
YOUTUBE_DAILY_SEARCH_LIMIT=20
